diff --git a/Sources/WASI/Platform/DescriptorTransfer.swift b/Sources/WASI/Platform/DescriptorTransfer.swift
new file mode 100644
index 0000000..60cb955
--- /dev/null
+++ b/Sources/WASI/Platform/DescriptorTransfer.swift
@@ -0,0 +1,14 @@
+#if canImport(Darwin)
+    import Darwin
+#endif
+
+/// Protect a descriptor while it is between the guest table and the host close.
+/// Blocking guest I/O must stay outside this scope.
+func withDescriptorTransfer<Result>(_ body: () throws -> Result) rethrows -> Result {
+    #if canImport(Darwin)
+        var previous: CInt = PTHREAD_CANCEL_ENABLE
+        pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &previous)
+        defer { pthread_setcancelstate(previous, nil) }
+    #endif
+    return try body()
+}
