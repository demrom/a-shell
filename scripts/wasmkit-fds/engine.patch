diff --git a/Sources/WASI/Platform/ProcessDescriptors.swift b/Sources/WASI/Platform/ProcessDescriptors.swift
new file mode 100644
index 0000000..f9762e7
--- /dev/null
+++ b/Sources/WASI/Platform/ProcessDescriptors.swift
@@ -0,0 +1,87 @@
+#if canImport(Darwin)
+    import Darwin
+#endif
+
+// The command bridge must mask pthread cancellation through each ownership
+// transfer, including receipt of any returned raw host descriptor.
+extension WASIBridgeToHost {
+    /// Install the two owned ends of a pipe in the guest's actual Preview 1 table.
+    @_spi(WASIPlatform) public func createProcessPipe() throws -> (read: Int32, write: Int32) {
+        #if canImport(Darwin)
+            try underlying.fdTable.withLock { table in
+                let read = try firstFreeProcessDescriptor(in: table)
+                let write = try firstFreeProcessDescriptor(in: table, excluding: read)
+                var pair: [CInt] = [-1, -1]
+                try valueOrErrno { Darwin.pipe(&pair) }
+                do {
+                    for index in pair.indices {
+                        let fd = pair[index]
+                        // a-Shell's WASI layer reserves host fd 4 for /dev/tty.
+                        if fd < 5 {
+                            pair[index] = try valueOrErrno { fcntl(fd, F_DUPFD_CLOEXEC, 5) }
+                            _ = Darwin.close(fd)
+                        } else {
+                            try valueOrErrno { fcntl(fd, F_SETFD, FD_CLOEXEC) }
+                        }
+                    }
+                    try valueOrErrno { fcntl(pair[1], F_SETNOSIGPIPE, 1) }
+                } catch {
+                    for fd in pair { _ = Darwin.close(fd) }
+                    throw error
+                }
+                table[read] = .file(RegularFileEntry(fd: FileDescriptor(rawValue: pair[0]), accessMode: .read))
+                table[write] = .file(RegularFileEntry(fd: FileDescriptor(rawValue: pair[1]), accessMode: .write))
+                return (Int32(read), Int32(write))
+            }
+        #else
+            throw WASIAbi.Errno.ENOTSUP
+        #endif
+    }
+
+    /// POSIX `dup2` in the guest namespace. This never moves or consumes `source`.
+    @_spi(WASIPlatform) public func duplicateProcessDescriptor(_ source: UInt32, to target: UInt32) throws {
+        #if canImport(Darwin)
+            let displaced = try underlying.fdTable.withLock { table -> (any WASIEntry)? in
+                guard let original = table[source] else { throw WASIAbi.Errno.EBADF }
+                guard source != target else { return nil }
+                guard let file = original.asFile() as? any FdWASIFile else { throw WASIAbi.Errno.ENOTSUP }
+                let fd = try valueOrErrno { fcntl(file.fd.rawValue, F_DUPFD_CLOEXEC, 5) }
+                let prior = table[target]?.asEntry()
+                table[target] = .file(RegularFileEntry(fd: FileDescriptor(rawValue: fd), accessMode: file.accessMode))
+                return prior
+            }
+            // POSIX does not report an error closing the displaced descriptor.
+            if let displaced, !displaced.isBorrowed, displaced.hostFileDescriptor != 4 {
+                try? displaced.close()
+            }
+        #else
+            throw WASIAbi.Errno.ENOTSUP
+        #endif
+    }
+
+    /// Check whether the guest has a descriptor before applying a spawn action.
+    @_spi(WASIPlatform) public func containsProcessDescriptor(_ descriptor: UInt32) -> Bool {
+        underlying.fdTable.withLock { $0[descriptor] != nil }
+    }
+
+    /// Duplicate a guest file for one child stdio stream. The caller owns the result.
+    @_spi(WASIPlatform) public func duplicateProcessHostDescriptor(_ descriptor: UInt32, writing: Bool) throws -> CInt {
+        #if canImport(Darwin)
+            try underlying.fdTable.withLock { table in
+                guard let entry = table[descriptor] else { throw WASIAbi.Errno.EBADF }
+                guard let file = entry.asFile() as? any FdWASIFile else { throw WASIAbi.Errno.ENOTSUP }
+                guard file.accessMode.contains(writing ? .write : .read) else { throw WASIAbi.Errno.EBADF }
+                return try valueOrErrno { fcntl(file.fd.rawValue, F_DUPFD_CLOEXEC, 5) }
+            }
+        #else
+            throw WASIAbi.Errno.ENOTSUP
+        #endif
+    }
+
+    private func firstFreeProcessDescriptor(in table: FdTable, excluding: UInt32? = nil) throws -> UInt32 {
+        for descriptor in 0...UInt32(Int32.max) where descriptor != excluding && table[descriptor] == nil {
+            return descriptor
+        }
+        throw WASIAbi.Errno.EMFILE
+    }
+}
