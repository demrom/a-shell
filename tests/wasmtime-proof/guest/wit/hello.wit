package ashell:proof;

world hello {
    import wasi:cli/stdout@0.3.1;
    export wasi:cli/run@0.3.1;
}

world https {
    import wasi:cli/environment@0.3.1;
    import wasi:cli/stdout@0.3.1;
    import wasi:http/client@0.3.1;
    export wasi:cli/run@0.3.1;
}

world tty {
    include ashell:tty/terminal@0.1.0;
    import wasi:cli/environment@0.3.1;
    import wasi:cli/stdin@0.3.1;
    import wasi:cli/stdout@0.3.1;
    import wasi:cli/terminal-stdin@0.3.1;
    import wasi:cli/terminal-stdout@0.3.1;
    import wasi:cli/terminal-stderr@0.3.1;
    export wasi:cli/run@0.3.1;
}
