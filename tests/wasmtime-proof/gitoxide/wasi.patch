diff -ruN a/gix-transport/src/client/blocking_io/http/wasi.rs b/gix-transport/src/client/blocking_io/http/wasi.rs
--- a/gix-transport/src/client/blocking_io/http/wasi.rs	1970-01-01 03:00:00.000000000 +0300
+++ b/gix-transport/src/client/blocking_io/http/wasi.rs	2026-10-18 14:50:05.269178151 +0300
@@ -0,0 +1,264 @@
+//! Thread-free transport over stock WASI HTTP, with a streamed response body.
+use super::{GetResponse, Http, Options, PostBodyDataKind, PostResponse};
+use gix_error::{Result, ResultExt};
+use std::{
+    any::Any,
+    io::{self, BufRead, Cursor, Read, Write},
+    sync::{Arc, Mutex},
+};
+
+#[derive(Default)]
+/// Stock WASI HTTP client without guest threads.
+pub struct Remote {
+    options: Options,
+}
+
+struct Pending {
+    request: Option<waki::RequestBuilder>,
+    upload: Vec<u8>,
+    upload_complete: bool,
+    response: Option<waki::Response>,
+}
+impl Pending {
+    fn start(&mut self) -> io::Result<()> {
+        if self.response.is_some() {
+            return Ok(());
+        }
+        if !self.upload_complete {
+            return Err(io::Error::other(
+                "POST body must be dropped before reading the response",
+            ));
+        }
+        let request = self
+            .request
+            .take()
+            .ok_or_else(|| io::Error::other("HTTP request already failed"))?;
+        let response = request
+            .body(std::mem::take(&mut self.upload))
+            .send()
+            .map_err(io::Error::other)?;
+        if response.status_code() == 401 {
+            return Err(io::Error::new(
+                io::ErrorKind::PermissionDenied,
+                "HTTP authentication required",
+            ));
+        }
+        if !(200..300).contains(&response.status_code()) {
+            return Err(io::Error::other(format!(
+                "HTTP status {} (WASI redirect handling is not implemented)",
+                response.status_code()
+            )));
+        }
+        self.response = Some(response);
+        Ok(())
+    }
+}
+
+/// Lazy response headers; reading starts the request after its body is dropped.
+pub struct Headers {
+    pending: Arc<Mutex<Pending>>,
+    bytes: Option<Cursor<Vec<u8>>>,
+}
+impl BufRead for Headers {
+    fn fill_buf(&mut self) -> io::Result<&[u8]> {
+        if self.bytes.is_none() {
+            let mut state = self
+                .pending
+                .lock()
+                .map_err(|_| io::Error::other("HTTP state poisoned"))?;
+            state.start()?;
+            let mut data = Vec::new();
+            for (name, value) in state.response.as_ref().unwrap().headers() {
+                data.extend_from_slice(name.as_str().as_bytes());
+                data.extend_from_slice(b": ");
+                data.extend_from_slice(value.as_bytes());
+                data.push(b'\n');
+            }
+            self.bytes = Some(Cursor::new(data));
+        }
+        self.bytes.as_mut().unwrap().fill_buf()
+    }
+    fn consume(&mut self, count: usize) {
+        if let Some(bytes) = &mut self.bytes {
+            bytes.consume(count);
+        }
+    }
+}
+impl Read for Headers {
+    fn read(&mut self, dest: &mut [u8]) -> io::Result<usize> {
+        let data = self.fill_buf()?;
+        let count = data.len().min(dest.len());
+        dest[..count].copy_from_slice(&data[..count]);
+        self.consume(count);
+        Ok(count)
+    }
+}
+
+/// Response reader retaining only the current 64 KiB chunk.
+pub struct ResponseBody {
+    pending: Arc<Mutex<Pending>>,
+    bytes: Cursor<Vec<u8>>,
+    done: bool,
+}
+impl BufRead for ResponseBody {
+    fn fill_buf(&mut self) -> io::Result<&[u8]> {
+        while self.bytes.position() as usize == self.bytes.get_ref().len() && !self.done {
+            let mut state = self
+                .pending
+                .lock()
+                .map_err(|_| io::Error::other("HTTP state poisoned"))?;
+            state.start()?;
+            match state
+                .response
+                .as_ref()
+                .unwrap()
+                .chunk(65536)
+                .map_err(io::Error::other)?
+            {
+                Some(chunk) => self.bytes = Cursor::new(chunk),
+                None => self.done = true,
+            }
+        }
+        self.bytes.fill_buf()
+    }
+    fn consume(&mut self, count: usize) {
+        self.bytes.consume(count);
+    }
+}
+impl Read for ResponseBody {
+    fn read(&mut self, dest: &mut [u8]) -> io::Result<usize> {
+        let data = self.fill_buf()?;
+        let count = data.len().min(dest.len());
+        dest[..count].copy_from_slice(&data[..count]);
+        self.consume(count);
+        Ok(count)
+    }
+}
+
+/// Request writer buffered up to 8 MiB; drop completes the request body.
+pub struct PostBody {
+    pending: Arc<Mutex<Pending>>,
+}
+impl Write for PostBody {
+    fn write(&mut self, data: &[u8]) -> io::Result<usize> {
+        let mut state = self
+            .pending
+            .lock()
+            .map_err(|_| io::Error::other("HTTP state poisoned"))?;
+        if state.upload.len().saturating_add(data.len()) > 8 * 1024 * 1024 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "WASI HTTP request body exceeds 8 MiB",
+            ));
+        }
+        state.upload.extend_from_slice(data);
+        Ok(data.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
+impl Drop for PostBody {
+    fn drop(&mut self) {
+        if let Ok(mut state) = self.pending.lock() {
+            state.upload_complete = true;
+        }
+    }
+}
+
+impl Remote {
+    fn request(
+        &self,
+        url: &str,
+        headers: impl IntoIterator<Item = impl AsRef<str>>,
+        post: bool,
+    ) -> Result<PostResponse<Headers, ResponseBody, PostBody>> {
+        let mut request = if post {
+            waki::Client::new().post(url)
+        } else {
+            waki::Client::new().get(url)
+        };
+        let headers: Vec<String> = headers.into_iter().map(|s| s.as_ref().to_owned()).collect();
+        for line in self.options.extra_headers.iter().chain(headers.iter()) {
+            let (name, value) = line
+                .split_once(':')
+                .ok_or_else(|| io::Error::other("invalid HTTP header"))
+                .or_error()?;
+            let name = waki::header::HeaderName::from_bytes(name.trim().as_bytes()).or_error()?;
+            request = request.header(name, value.trim().to_owned());
+        }
+        if let Some(agent) = &self.options.user_agent {
+            request = request.header("user-agent", agent.as_str());
+        }
+        if let Some(timeout) = self.options.connect_timeout {
+            request = request.connect_timeout(timeout);
+        }
+        let pending = Arc::new(Mutex::new(Pending {
+            request: Some(request),
+            upload: Vec::new(),
+            upload_complete: !post,
+            response: None,
+        }));
+        Ok(PostResponse {
+            headers: Headers {
+                pending: pending.clone(),
+                bytes: None,
+            },
+            body: ResponseBody {
+                pending: pending.clone(),
+                bytes: Cursor::new(Vec::new()),
+                done: false,
+            },
+            post_body: PostBody { pending },
+        })
+    }
+}
+impl Http for Remote {
+    type Headers = Headers;
+    type ResponseBody = ResponseBody;
+    type PostBody = PostBody;
+    fn get(
+        &mut self,
+        url: &str,
+        _base_url: &str,
+        headers: impl IntoIterator<Item = impl AsRef<str>>,
+    ) -> Result<GetResponse<Headers, ResponseBody>> {
+        self.request(url, headers, false).map(Into::into)
+    }
+    fn post(
+        &mut self,
+        url: &str,
+        _base_url: &str,
+        headers: impl IntoIterator<Item = impl AsRef<str>>,
+        _body: PostBodyDataKind,
+    ) -> Result<PostResponse<Headers, ResponseBody, PostBody>> {
+        self.request(url, headers, true)
+    }
+    fn configure(&mut self, config: &dyn Any) -> Result {
+        let Some(options) = config.downcast_ref::<Options>() else {
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "unknown WASI HTTP configuration",
+            ))
+            .or_error();
+        };
+        if options.proxy.as_ref().is_some_and(|s| !s.is_empty())
+            || options.proxy_authenticate.is_some()
+            || options.ssl_ca_info.is_some()
+            || options.ssl_version.is_some()
+            || !options.ssl_verify
+            || options.http_version.is_some()
+            || options.backend.is_some()
+            || options.low_speed_limit_bytes_per_second != 0
+            || options.low_speed_time_seconds != 0
+        {
+            return Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "WASI HTTP host owns TLS, proxies and protocol settings; requested client override is unsupported",
+            ))
+            .or_error();
+        }
+        self.options = options.clone();
+        Ok(())
+    }
+}
