;; Public wasmkit smoke: host pipe and dup2 share the guest WASI FD table.
;; Generate pipe.hex with: wasm-tools parse pipe.wat -o pipe.wasm && xxd -p pipe.wasm > pipe.hex
(module
  (import "ashell_v1" "process_pipe" (func $pipe (param i32) (result i32)))
  (import "ashell_v1" "process_dup2" (func $dup2 (param i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_close" (func $close (param i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_read" (func $read (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "fd_write" (func $write (param i32 i32 i32 i32) (result i32)))
  (import "wasi_snapshot_preview1" "proc_exit" (func $exit (param i32)))
  (memory (export "memory") 1)
  (data (i32.const 128) "a\00b\0a")
  (data (i32.const 132) "process-pipe-ok\0a")
  (func $check (param $error i32) (param $status i32)
    (if (local.get $error) (then (call $exit (local.get $status)) (unreachable))))
  (func $iov (param $offset i32) (param $length i32)
    (i32.store (i32.const 16) (local.get $offset))
    (i32.store (i32.const 20) (local.get $length)))
  (func (export "_start")
    (local $reader i32) (local $writer i32)
    (call $check (call $pipe (i32.const 8)) (i32.const 90))
    (local.set $reader (i32.load (i32.const 8)))
    (local.set $writer (i32.load (i32.const 12)))
    (call $check (call $dup2 (local.get $writer) (i32.const 42)) (i32.const 91))
    (call $check (call $close (local.get $writer)) (i32.const 92))
    (call $iov (i32.const 128) (i32.const 4))
    (call $check (call $write (i32.const 42) (i32.const 16) (i32.const 1) (i32.const 24)) (i32.const 93))
    (call $check (i32.ne (i32.load (i32.const 24)) (i32.const 4)) (i32.const 94))
    (call $check (call $close (i32.const 42)) (i32.const 95))
    (call $iov (i32.const 256) (i32.const 4))
    (call $check (call $read (local.get $reader) (i32.const 16) (i32.const 1) (i32.const 24)) (i32.const 96))
    (call $check (i32.ne (i32.load (i32.const 24)) (i32.const 4)) (i32.const 97))
    (call $check (i32.ne (i32.load (i32.const 256)) (i32.load (i32.const 128))) (i32.const 98))
    (call $check (call $read (local.get $reader) (i32.const 16) (i32.const 1) (i32.const 24)) (i32.const 99))
    (call $check (i32.load (i32.const 24)) (i32.const 100))
    (call $check (call $close (local.get $reader)) (i32.const 101))
    (call $iov (i32.const 132) (i32.const 16))
    (call $check (call $write (i32.const 1) (i32.const 16) (i32.const 1) (i32.const 24)) (i32.const 102))
    (call $check (i32.ne (i32.load (i32.const 24)) (i32.const 16)) (i32.const 103))))
